# Python virtual environment (recreate with `uv sync`)
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# Input data: your historical Parquet files (large; keep the folder itself)
data/historical/*
!data/historical/.gitkeep

# Generated: the Nautilus data catalog (rebuild with scripts/build_catalog.py)
catalog/

# Generated: backtest reports
reports/

# Real secrets (Angel One API key, client code, PIN, TOTP secret)
.env

# macOS clutter
.DS_Store
