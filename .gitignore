# Python virtual environment (recreate with `uv sync`)
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# Generated Parquet data catalog (rebuild with scripts/catalog_setup.py)
catalog/

# Historical Parquet files (large; keep the folder itself)
data/historical/*
!data/historical/.gitkeep

# Real secrets — never commit
.env

# macOS clutter
.DS_Store
